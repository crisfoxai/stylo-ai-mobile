# Flutter env vars — pasar vía --dart-define al build, NO como archivo .env runtime.
# flutter_dotenv fue removido. Esta app usa String.fromEnvironment (lib/core/env.dart).
#
# Ejemplo build debug para emulador Android:
#   flutter build apk --debug \
#     --dart-define=API_BASE_URL=http://10.0.2.2:4000/api/v1 \
#     --dart-define=ENVIRONMENT=dev \
#     --dart-define=FIREBASE_PROJECT_ID=stylo-ai-7070 \
#     --dart-define=FIREBASE_API_KEY=... \
#     --dart-define=FIREBASE_APP_ID=... \
#     --dart-define=FIREBASE_MESSAGING_SENDER_ID=326882772609
#
# Para producción, usar --dart-define-from-file=env.prod.json en CI/CD.

API_BASE_URL=http://10.0.2.2:4000/api/v1
ENVIRONMENT=dev
FIREBASE_PROJECT_ID=stylo-ai-7070
FIREBASE_API_KEY=...
FIREBASE_APP_ID=...
FIREBASE_MESSAGING_SENDER_ID=326882772609
SENTRY_DSN_CLIENT=
